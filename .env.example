NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_me
# Backend origin, private to the Next.js server. Use HTTPS for deployed traffic.
API_BACKEND_URL=http://localhost:3016

# Optional: HTTPS Pterodactyl statistics, independent of backend ingress.
# Keep the client key server-side (never NEXT_PUBLIC_). Prefer a read-only panel account.
PTERODACTYL_URL=
PTERODACTYL_SERVER_ID=
PTERODACTYL_CLIENT_API_KEY=
